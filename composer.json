{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "kwasii/laravel-sql-parser",
    "description": "Fast SQL Parser for PHP Laravel",
    "keywords": [
        "laravel",
        "kwasii1",
        "laravel-sql-parser"
    ],
    "homepage": "https://github.com/kwasii1/laravel-sql-parser",
    "license": "MIT",
    "authors": [
        {
            "name": "Kwasi Sakyi Baidoo",
            "email": "kesbijnr@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/console": "^12.0||^13.0",
        "illuminate/database": "^12.0||^13.0",
        "illuminate/support": "^12.0||^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "laravel/pao": "^1.0",
        "laravel/pint": "^1.29",
        "orchestra/testbench": "^10.0||^11.0",
        "pestphp/pest": "^4.6||^5.0",
        "pestphp/pest-plugin-laravel": "^4.1||^5.0",
        "pestphp/pest-plugin-type-coverage": "^4.0||^5.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "Kwasii\\LaravelSqlParser\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kwasii\\LaravelSqlParser\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "prepare": [
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "build": [
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "lint": [
            "vendor/bin/pint --parallel"
        ],
        "lint:check": [
            "vendor/bin/pint --parallel --test"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse"
        ],
        "generate": [
            "@php tools/generate.php"
        ],
        "generate:check": [
            "@php tools/generate.php --check"
        ],
        "test:types": [
            "vendor/bin/pest --type-coverage --min=100"
        ],
        "test:unit": [
            "vendor/bin/pest --parallel"
        ],
        "test": [
            "@analyse",
            "@lint:check",
            "@generate:check",
            "@test:types",
            "@test:unit"
        ],
        "clear": [
            "@php vendor/bin/testbench package:purge-skeleton --ansi"
        ],
        "bench": [
            "Composer\\Config::disableProcessTimeout",
            "@php -d opcache.enable_cli=1 benchmarks/run.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Kwasii\\LaravelSqlParser\\LaravelSqlParserServiceProvider"
            ],
            "aliases": {
                "LaravelSqlParser": "Kwasii\\LaravelSqlParser\\Facades\\LaravelSqlParser"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
